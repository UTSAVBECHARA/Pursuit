# ==============================================================================
# Pursuit Environment Configuration Example
# Copy this file to .env and configure the values appropriately.
# NEVER commit your actual .env file or credentials to version control.
# ==============================================================================

# LLM Gateway & Provider Configuration
# Obtain an API key from OrcaRouter (https://www.orcarouter.ai) or compatible OpenAI endpoint
ORCAROUTER_API_KEY=your_orcarouter_api_key_here

# Execution Mode
# Set to 1 to enable dry-run simulation mode (safe trial; verifies and fills forms without submitting)
AIHAWK_DRY_RUN=1

# Debug & Tracing
# Set to 1 to log step-by-step browser interactions into data/trace.log
AIHAWK_TRACE=0

# AI Models (Optional overrides; defaults are tuned for speed, accuracy, and schema compliance)
# AIHAWK_MODEL=deepseek/deepseek-v4.1-flash
# AIHAWK_QUICK_MODEL=google/gemini-3.5-flash
# AIHAWK_DECISION_MODEL=typesafe/jev-1.14

# Job Database & Manifest URL
# AIHAWK_DATABASE=https://huggingface.co/datasets/feder-cr/jobs/resolve/main/library/manifest.json

# Web & Deployment Port (For containerized / cloud deployment)
PORT=8000
